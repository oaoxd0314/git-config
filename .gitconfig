[user]
    name = Chris Wang
    email = chris.w@gmicloud.ai

[core]
    ignoreCase = false

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    cm = commit -m
    cam = commit -am
    cane = commit --amend --no-edit
    unstage = reset HEAD --
    last = log -1 HEAD
    aliases = "!git config --get-regexp ^alias\\. | sed 's/^alias\\.//'"
    refresh = !git fetch origin --prune && git fetch upstream --prune && echo "✓ All remotes updated (origin, upstream)"

[pull]
    rebase = true
    ff = only

[includeIf "gitdir/i:~/Code/Personal/"] 
    path = ~/.gitconfig-personal
[init]
	defaultBranch = master
